<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A14">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Detection sensitivity -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#12122A"
            app:cardCornerRadius="12dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Detection Sensitivity"
                        android:textColor="#E0E0FF" android:textSize="15sp"/>
                    <TextView android:id="@+id/tvSensitivity"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="50%" android:textColor="#00FFDC" android:textSize="13sp"/>
                </LinearLayout>

                <SeekBar android:id="@+id/seekSensitivity"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:max="100" android:progress="50"
                    android:progressTint="#00FFDC" android:thumbTint="#00FFDC"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Higher = more detections, may include false positives"
                    android:textColor="#506070" android:textSize="11sp" android:layout_marginTop="4dp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Counting line position -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#12122A"
            app:cardCornerRadius="12dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Counting Line Position"
                        android:textColor="#E0E0FF" android:textSize="15sp"/>
                    <TextView android:id="@+id/tvLinePos"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="50%" android:textColor="#FF0096" android:textSize="13sp"/>
                </LinearLayout>

                <SeekBar android:id="@+id/seekLinePos"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:max="100" android:progress="50"
                    android:progressTint="#FF0096" android:thumbTint="#FF0096"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Move the counting line up or down in the camera view"
                    android:textColor="#506070" android:textSize="11sp" android:layout_marginTop="4dp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- App info -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#12122A"
            app:cardCornerRadius="12dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp" android:gravity="center">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Parish Counter" android:textColor="#00FFDC"
                    android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Version 1.0" android:textColor="#6080A0" android:textSize="12sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="AI-powered people counting for churches"
                    android:textColor="#506070" android:textSize="11sp" android:layout_marginTop="4dp"
                    android:gravity="center"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>