<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0A14">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <ImageView
            android:id="@+id/overlayView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="10dp"
            android:padding="6dp"
            android:text="IDLE"
            android:textColor="#6080A0"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="#CC0E0E22"/>

        <TextView
            android:id="@+id/tvPausedOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="⏸ PAUSED"
            android:textColor="#FFB400"
            android:textSize="28sp"
            android:textStyle="bold"
            android:background="#99000000"
            android:visibility="gone"/>

    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#12122A"
        android:padding="8dp">

        <LinearLayout android:id="@+id/cardInside"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:gravity="center" android:padding="10dp"
            android:background="@drawable/card_bg_cyan"
            android:layout_marginEnd="4dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="INSIDE" android:textColor="#6080A0" android:textSize="9sp"/>
            <TextView android:id="@+id/tvInside" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="0"
                android:textColor="#00FFDC" android:textSize="32sp" android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/cardEntries"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:gravity="center" android:padding="10dp"
            android:background="@drawable/card_bg_green"
            android:layout_marginEnd="4dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="ENTRIES" android:textColor="#6080A0" android:textSize="9sp"/>
            <TextView android:id="@+id/tvEntries" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="0"
                android:textColor="#00FF78" android:textSize="32sp" android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/cardExits"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:gravity="center" android:padding="10dp"
            android:background="@drawable/card_bg_pink">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="EXITS" android:textColor="#6080A0" android:textSize="9sp"/>
            <TextView android:id="@+id/tvExits" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="0"
                android:textColor="#FF0096" android:textSize="32sp" android:textStyle="bold"/>
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#0E0E20"
        android:padding="12dp">

        <EditText
            android:id="@+id/etServiceName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Service name (e.g. Sunday Morning)"
            android:textColor="#E0E0FF"
            android:textColorHint="#506070"
            android:inputType="text"
            android:background="#1A1A30"
            android:padding="10dp"
            android:textSize="14sp"
            android:layout_marginBottom="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <Button android:id="@+id/btnStart"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="▶ Start"
                android:textColor="#00FF78" android:backgroundTint="#1A2A1A"
                android:layout_marginEnd="4dp"/>

            <Button android:id="@+id/btnPause"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="⏸ Pause"
                android:textColor="#FFB400" android:backgroundTint="#2A1E00"
                android:enabled="false"
                android:layout_marginEnd="4dp"/>

            <Button android:id="@+id/btnStop"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="■ Stop"
                android:textColor="#FF0096" android:backgroundTint="#2A1A1A"
                android:enabled="false"/>

        </LinearLayout>

        <Button android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💾  Save Report"
            android:textColor="#00FFDC"
            android:backgroundTint="#1A2A2A"
            android:enabled="false"/>

    </LinearLayout>

</LinearLayout>